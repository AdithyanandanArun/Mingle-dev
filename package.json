{
  "name": "mingle-workspace",
  "version": "0.0.9",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,blue \"pnpm --filter @mingle/server dev\" \"pnpm --filter @mingle/web dev\"",
    "build": "pnpm --filter @mingle/web build && pnpm --filter @mingle/server build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @mingle/server test",
    "smoke": "node scripts/smoke.mjs",
    "start": "pnpm --filter @mingle/server start",
    "desktop": "pnpm --filter @mingle/desktop start",
    "package:linux": "pnpm build && node scripts/package-desktop.mjs",
    "package:arch": "pnpm package:linux && node scripts/package-arch.mjs",
    "package:deb": "pnpm package:linux && node scripts/package-deb.mjs",
    "package:windows": "pnpm build && node scripts/package-desktop.mjs && node scripts/package-windows.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  }
}
